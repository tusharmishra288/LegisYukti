# --- Environment & Secrets ---
.env
.venv/
__pycache__/
*.py[cod]
*$py.class

# --- Local Databases (User History & State) ---
# Prevents sharing specific user conversation history
chatbot.db
chatbot.db-journal

# --- Large Model Weights & Data Caches ---
# These are managed locally to prevent C: drive bloat and shouldn't be in Git
model_cache/
vec_store/
scratch/

# --- Input Documents & Logs ---
logs/

# --- UV & Build Artifacts ---
.uv/
dist/
build/
*.egg-info/

# --- OS Specific Files ---
.DS_Store
Thumbs.db

# Eval run artifacts: regenerated by `python -m eval.run_eval`, and they embed
# full answer + context text, so they are large and churn on every run.
# Force-add a reference run if you want it versioned:  git add -f eval/results/baseline-final.json
eval/results/
