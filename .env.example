# LegisYukti environment
# Copy to .env in the project root (.env is gitignored) and fill in.
# Locally, src/config.py loads this via python-dotenv. On Hugging Face Spaces set
# the same names under Settings -> Variables and secrets instead.

# --- REQUIRED --------------------------------------------------------------- #

# Groq API key. Powers both models: llama-3.3-70b-versatile (synthesis, routing)
# and llama-3.1-8b-instant (classification, query expansion, audit).
# Read at import time in src/config.py, so the app will not start without it.
# https://console.groq.com/keys
GROQ_API_KEY=

# Qdrant Cloud cluster endpoint, including scheme and port.
# e.g. https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# --- REQUIRED BY THE APP, NOT BY THE EVAL ----------------------------------- #

# PostgreSQL connection string for LangGraph conversation checkpointing and the
# audit_logs table (Neon, Supabase, or any Postgres). app.py needs it.
# eval/run_eval.py uses an in-memory checkpointer and does NOT need it.
# Note: if this is a free-tier Neon/Supabase instance it has its own inactivity
# suspension - the same problem the Qdrant keep-alive workflow solves.
POSTGRES_URI=

# --- OPTIONAL: MODEL SELECTION ----------------------------------------------- #

# Groq retires models on a rolling basis, so the model IDs are configurable here
# rather than hard-coded. Leave blank to use the defaults in src/config.py.
# List what your account can actually serve:
#   curl -s https://api.groq.com/openai/v1/models \
#        -H "Authorization: Bearer $GROQ_API_KEY" | jq -r '.data[].id' | sort
# `python -m eval.preflight` prints the same list automatically when a model 404s.
#   PRIMARY = synthesis + tool dispatch (needs strong reasoning, ~800 output tokens)
#   FAST    = routing, classification, query expansion, audit (short outputs, high volume)
GROQ_MODEL_PRIMARY=
GROQ_MODEL_FAST=

# --- OPTIONAL: HARDWARE ------------------------------------------------------ #

# Force a torch backend: cuda | mps | cpu. Leave blank to auto-detect, which
# prefers cuda, then mps (Apple Silicon), then cpu. An override naming a backend
# this machine does not have logs a warning and falls back, so the same .env is
# safe to carry between your Mac and a CUDA box.
# Affects the e5-small-v2 embedding model. FlashRank reranking runs on ONNX
# Runtime and stays on CPU regardless.
DEVICE_TYPE=

# --- OPTIONAL ---------------------------------------------------------------- #

# HuggingFace token. Only needed for gated models; intfloat/e5-small-v2 and
# ms-marco-MiniLM-L-12-v2 are both public, so this can stay empty.
# src/config.py logs a warning when unset and carries on.
HF_TOKEN=

# Per-query latency tracing (src/telemetry.py). Default on.
# Must be ON for eval/run_eval.py to report timings. Set to 0 to disable.
LEGISYUKTI_TELEMETRY=1

# --- SET FOR YOU, DO NOT CONFIGURE ------------------------------------------- #
#   DEVICE                          derived from DEVICE_TYPE / auto-detection
#   HF_HOME, FASTEMBED_CACHE_PATH   set by src/config.py to ./model_cache/
#   HUGGING_FACE_HUB_TOKEN          mirrored from HF_TOKEN by src/config.py
#   SPACE_HOST                      injected by Hugging Face Spaces at runtime
#   PGCHANNELBINDING, SSL_CERT_FILE set in the Dockerfile
